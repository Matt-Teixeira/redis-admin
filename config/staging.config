# Basic persistence & safe defaults
appendonly yes
save 900 1
save 300 10
save 60 10000


# You can add instance-specific tweaks here if needed.

# Auth (standardized 2026-08-19; supersedes the REDIS-01-era exception): password
# lives in a root-only file on the host, bind-mounted by compose. Later directives
# win, so this include overrides any commented example above. NOTE: this instance's
# consumer is odd-jobs, whose Redis client historically had no password support —
# auth here was enabled deliberately; coordinate any odd-jobs breakage with Jonathan.
include /usr/local/etc/redis/auth.conf
