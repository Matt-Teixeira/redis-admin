# Basic persistence & safe defaults
appendonly yes
save 900 1
save 300 10
save 60 10000


# You can add instance-specific tweaks here if needed.

# Auth (REDIS-01 rollout 2026-08-18; standardized on ALL FOUR instances
# 2026-08-19, incl. redis-STAGING): password lives in a root-only file on the
# host, bind-mounted by compose. Later directives win, so this include overrides
# any commented example above.
include /usr/local/etc/redis/auth.conf
