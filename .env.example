# redis-admin .env template — copy to .env and fill per host.
# .env itself is gitignored; THIS file is the tracked record of required keys.
# Every key describes the SERVER, not the release — so there are no #RELEASE:
# overrides, and the dev clone and release copy hold the same values.

# Used by build-release.sh to derive the release destination (/opt/apps/<APP_NAME>).
APP_NAME=redis-admin

# Dedicated bridge network with static IPs. Consumers reach the instances by
# container name or IP on the external network 'redis-admin_redis_net'.
REDIS_SUBNET=172.24.0.0/24
REDIS_GATEWAY=172.24.0.1

REDIS_PROD_IP=172.24.0.2
REDIS_STAGING_IP=172.24.0.3
REDIS_DEV04_IP=172.24.0.4
REDIS_DEV05_IP=172.24.0.5

# NOT here on purpose:
# - Auth: all four instances read requirepass from the root-only host file
#   /opt/resources/secrets/redis_auth.conf via an include in config/*.config.
# - RELEASE_SHA: injected into the DEPLOYED .env by build-release.sh — never
#   set by hand; a dev clone has no key and compose renders the provenance
#   label as 'dev-tree'.
